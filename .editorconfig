root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake,CMakePresets.json}]
indent_size = 2

[*.{yml,yaml,json,js,html,css}]
indent_size = 2

[*.md]
indent_size = 2
max_line_length = off
